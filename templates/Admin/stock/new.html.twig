{% extends 'reusable/final_layout.html.twig' %}

{% block title %}New Stock{% endblock %}

{% block body_class %}stock-new-page{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('stock_new') }}
{% endblock %}

{% block content %}
<div class="stock-new-container">
  <div class="new-header">
    <h1>Create New Stock</h1>
  </div>

  <div class="new-form-card">
    {{ include('Admin/stock/_form.html.twig') }}
  </div>

  <div class="new-actions">
    <a href="{{ path('app_stock_index') }}" class="btn-secondary">Back</a>
  </div>
</div>
{% endblock %}