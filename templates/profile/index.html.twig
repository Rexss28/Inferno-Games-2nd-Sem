{% extends 'reusable/final_layout.html.twig' %}

{% block title %}My Profile - {{ app.user.username }}{% endblock %}
{% block body_class %}profile-index-page{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Profile Page Specific Styles - Inferno Theme (Less Spacing Only) */
        .profile-index-page .profile-container {
            width: 100%;
            max-width: 900px;
            margin: 0 auto;
            background: #1c1c1c;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 0 12px rgba(0, 0, 0, 0.4);
            color: #f5f5f5;
            box-sizing: border-box;
        }

        /* Header Section */
        .profile-index-page .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #2c2c2c;
        }

        .profile-index-page .page-title {
            font-size: 1.6rem;
            font-weight: 600;
            color: #ffffff;
            margin: 0;
        }

        /* Profile Header */
        .profile-index-page .profile-header {
            text-align: center;
            margin-bottom: 1.5rem;
            padding: 1.5rem;
            background: #222;
            border-radius: 8px;
            border-left: 4px solid #FF2E2E;
        }

        /* Avatar - Original size but less margin */
        .profile-index-page .profile-avatar {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #FF2E2E, #FF6B2E);
            border-radius: 50%;
            margin: 0 auto 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            font-weight: bold;
            border: 4px solid #2c2c2c;
            box-shadow: 0 0 15px rgba(255, 46, 46, 0.3);
        }

        /* Profile Name */
        .profile-index-page .profile-name {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.3rem;
            color: #ffffff;
        }

        /* Profile Role Badge */
        .profile-index-page .profile-role {
            background: #2c2c2c;
            display: inline-block;
            padding: 0.4rem 1rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            margin-top: 0.3rem;
            color: #bdbdbd;
        }

        /* Info Grid - Less gap */
        .profile-index-page .profile-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        /* Info Cards - Less padding */
        .profile-index-page .info-card {
            background: #222;
            padding: 1.25rem;
            border-radius: 8px;
            border-left: 4px solid #FF2E2E;
            transition: all 0.3s ease;
            box-sizing: border-box;
            min-height: 140px;
            display: flex;
            flex-direction: column;
        }

        .profile-index-page .info-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(255, 46, 46, 0.2);
        }

        /* Info Labels */
        .profile-index-page .info-label {
            font-size: 0.8rem;
            color: #bdbdbd;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        /* Info Values */
        .profile-index-page .info-value {
            font-size: 1.1rem;
            color: #ffffff;
            font-weight: 500;
            margin-bottom: 0.75rem;
        }

        .profile-index-page .info-value.username {
            color: #FF6B2E;
            font-weight: 600;
            font-size: 1.2rem;
        }

        /* Role Badges */
        .profile-index-page .info-value.roles {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-top: 0.4rem;
        }

        .profile-index-page .role-badge {
            background: linear-gradient(135deg, #FF2E2E, #FF6B2E);
            color: white;
            padding: 0.2rem 0.7rem;
            border-radius: 15px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        /* Edit Buttons */
        .profile-index-page .btn-edit {
            background: #2c2c2c;
            color: #FF6B2E;
            border: 1px solid #FF6B2E;
            padding: 0.5rem 0.9rem;
            border-radius: 6px;
            font-size: 0.8rem;
            margin-top: auto;
            width: fit-content;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            cursor: pointer;
            text-decoration: none;
        }

        .profile-index-page .btn-edit:hover {
            background: #FF6B2E;
            color: white;
            transform: translateY(-2px);
        }

        /* Text Muted */
        .profile-index-page .text-muted {
            color: #bdbdbd;
            font-size: 0.85rem;
            margin-top: 0.4rem;
            line-height: 1.4;
        }

        /* Section Titles */
        .profile-index-page .section-title {
            font-size: 1.3rem;
            color: #ffffff;
            margin-bottom: 1rem;
            padding-bottom: 0.6rem;
            border-bottom: 2px solid #2c2c2c;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        /* Flash Messages - Less padding */
        .profile-index-page .alert {
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.9rem;
        }

        .profile-index-page .alert-success {
            background: rgba(46, 204, 113, 0.1);
            color: #2ecc71;
            border: 1px solid rgba(46, 204, 113, 0.2);
        }

        .profile-index-page .alert-danger {
            background: rgba(231, 76, 60, 0.1);
            color: #e74c3c;
            border: 1px solid rgba(231, 76, 60, 0.2);
        }

        /* Modal Styles - Less padding */
        .profile-index-page .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            box-sizing: border-box;
        }

        .profile-index-page .modal.active {
            display: flex;
        }

        .profile-index-page .modal-content {
            background: #1c1c1c;
            border-radius: 12px;
            padding: 1.5rem;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 0 25px rgba(255, 46, 46, 0.3);
            border: 1px solid #2c2c2c;
            color: #f5f5f5;
            box-sizing: border-box;
        }

        .profile-index-page .modal-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .profile-index-page .form-group {
            margin-bottom: 1rem;
        }

        .profile-index-page .form-label {
            display: block;
            margin-bottom: 0.4rem;
            color: #bdbdbd;
            font-weight: 500;
            font-size: 0.85rem;
        }

        .profile-index-page .form-control {
            width: 100%;
            padding: 0.65rem 0.9rem;
            background: #222;
            border: 1px solid #2c2c2c;
            border-radius: 8px;
            color: #ffffff;
            font-size: 0.9rem;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }

        .profile-index-page .form-control:focus {
            outline: none;
            border-color: #FF2E2E;
            box-shadow: 0 0 0 2px rgba(255, 46, 46, 0.2);
        }

        .profile-index-page .form-text {
            font-size: 0.8rem;
            color: #bdbdbd;
            margin-top: 0.4rem;
            display: block;
        }

        .profile-index-page .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
            margin-top: 1.5rem;
        }

        /* Buttons */
        .profile-index-page .btn {
            padding: 0.6rem 1rem;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            border: none;
            cursor: pointer;
            font-size: 0.9rem;
        }

        .profile-index-page .btn-primary {
            background: linear-gradient(135deg, #FF2E2E, #FF6B2E);
            color: white;
        }

        .profile-index-page .btn-primary:hover {
            background: linear-gradient(135deg, #FF6B2E, #FF2E2E);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 46, 46, 0.3);
        }

        .profile-index-page .btn-outline {
            background: transparent;
            border: 1px solid #2c2c2c;
            color: #bdbdbd;
        }

        .profile-index-page .btn-outline:hover {
            background: #2c2c2c;
            border-color: #3a3a3a;
        }

        /* Warning Alert */
        .profile-index-page .alert-warning {
            background: rgba(241, 196, 15, 0.1);
            color: #f1c40f;
            border: 1px solid rgba(241, 196, 15, 0.2);
            margin-bottom: 1rem;
            padding: 0.75rem;
            font-size: 0.85rem;
        }

        /* Icons */
        .profile-index-page .icon {
            width: 16px;
            height: 16px;
        }

        .profile-index-page .modal-title .icon {
            width: 18px;
            height: 18px;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .profile-index-page .profile-container {
                padding: 1.25rem;
            }
            
            .profile-index-page .profile-info-grid {
                grid-template-columns: 1fr;
                gap: 0.85rem;
            }
            
            .profile-index-page .profile-avatar {
                width: 70px;
                height: 70px;
                font-size: 1.8rem;
            }
            
            .profile-index-page .profile-name {
                font-size: 1.3rem;
            }
            
            .profile-index-page .page-title {
                font-size: 1.4rem;
            }
            
            .profile-index-page .modal-content {
                padding: 1.25rem;
                max-width: 400px;
            }
            
            .profile-index-page .header-section {
                flex-direction: column;
                gap: 0.75rem;
                align-items: flex-start;
            }
            
            .profile-index-page .form-actions {
                flex-direction: column;
            }
            
            .profile-index-page .form-actions .btn {
                width: 100%;
                justify-content: center;
            }
        }

        @media (max-width: 480px) {
            .profile-index-page .profile-container {
                padding: 1rem;
            }
            
            .profile-index-page .modal-content {
                padding: 1.25rem;
                max-width: 350px;
            }
            
            .profile-index-page .info-card {
                padding: 1rem;
                min-height: 130px;
            }
        }
    </style>
{% endblock %}

{% block content %}
<div class="profile-container">
    <!-- Header -->
    <div class="header-section">
        <h1 class="page-title">My Profile</h1>
    </div>

    <!-- Flash Messages -->
    {# {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {{ message }}
        </div>
    {% endfor %} #}

    <!-- Profile Header -->
    <div class="profile-header">
        <div class="profile-avatar">
            {{ app.user.username|first|upper }}
        </div>
        <h2 class="profile-name">{{ app.user.username }}</h2>
        <div class="profile-role">
            {% for role in app.user.displayRoles %}
                {{ role|replace({'ROLE_': ''})|title }}{% if not loop.last %}, {% endif %}
            {% else %}
                User
            {% endfor %}
        </div>
    </div>

    <!-- Account Information -->
    <div class="profile-section">
        <h3 class="section-title">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            Account Information
        </h3>
        
        <div class="profile-info-grid">
            <div class="info-card">
                <div class="info-label">Username</div>
                <div class="info-value username">{{ app.user.username }}</div>
                <button class="btn-edit" onclick="openModal('username')">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Change Username
                </button>
                <p class="text-muted">
                    Your unique identifier on the platform.
                </p>
            </div>
            
            <div class="info-card">
                <div class="info-label">User ID</div>
                <div class="info-value">#{{ app.user.id }}</div>
                <p class="text-muted">
                    Your unique system identifier.
                </p>
            </div>
            
            <div class="info-card">
                <div class="info-label">Password</div>
                <div class="info-value">••••••••</div>
                <button class="btn-edit" onclick="openModal('password')">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                    </svg>
                    Change Password
                </button>
                <p class="text-muted">
                    Your account password is securely encrypted.
                </p>
            </div>
            
            <div class="info-card">
                <div class="info-label">Account Roles</div>
                <div class="info-value roles">
                    {% for role in app.user.displayRoles %}
                        <span class="role-badge">{{ role|replace({'ROLE_': ''})|title }}</span>
                    {% else %}
                        <span class="role-badge">User</span>
                    {% endfor %}
                </div>
                <p class="text-muted">
                    Your assigned permissions and access levels.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Username Edit Modal -->
<div id="usernameModal" class="modal">
    <div class="modal-content">
        <h3 class="modal-title">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            Change Username
        </h3>
        
        <div class="alert alert-warning">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
            Please note: Changing your username will affect how you log in.
        </div>
        
        <form id="usernameForm" method="post" action="{{ path('profile_update_username') }}">
            <div class="form-group">
                <label class="form-label" for="newUsername">New Username</label>
                <input type="text" 
                       id="newUsername" 
                       name="newUsername" 
                       class="form-control" 
                       value="{{ app.user.username }}"
                       required
                       minlength="3"
                       maxlength="50"
                       pattern="[a-zA-Z0-9_]+">
                <span class="form-text">
                    Username must be 3-50 characters and can only contain letters, numbers, and underscores.
                </span>
            </div>
            
            <div class="form-actions">
                <button type="button" class="btn btn-outline" onclick="closeModal('usernameModal')">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Update Username
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Password Edit Modal -->
<div id="passwordModal" class="modal">
    <div class="modal-content">
        <h3 class="modal-title">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
            </svg>
            Change Password
        </h3>
        
        <div class="alert alert-warning">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            Your new password will be updated immediately.
        </div>
        
        <form id="passwordForm" method="post" action="{{ path('profile_update_password') }}">
            <div class="form-group">
                <label class="form-label" for="newPassword">New Password</label>
                <input type="password" 
                       id="newPassword" 
                       name="newPassword" 
                       class="form-control" 
                       required
                       minlength="6"
                       placeholder="Enter new password">
                <span class="form-text">
                    Password must be at least 6 characters long.
                </span>
            </div>
            
            <div class="form-group">
                <label class="form-label" for="confirmPassword">Confirm New Password</label>
                <input type="password" 
                       id="confirmPassword" 
                       name="confirmPassword" 
                       class="form-control" 
                       required
                       placeholder="Confirm new password">
                <span class="form-text">
                    Re-enter your new password for confirmation.
                </span>
            </div>
            
            <div class="form-actions">
                <button type="button" class="btn btn-outline" onclick="closeModal('passwordModal')">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Update Password
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Avatar hover effect
            const avatar = document.querySelector('.profile-avatar');
            if (avatar) {
                avatar.addEventListener('mouseenter', function() {
                    this.style.transform = 'scale(1.05)';
                    this.style.boxShadow = '0 0 20px rgba(255, 46, 46, 0.4)';
                });
                
                avatar.addEventListener('mouseleave', function() {
                    this.style.transform = 'scale(1)';
                    this.style.boxShadow = '0 0 15px rgba(255, 46, 46, 0.3)';
                });
            }
            
            // Info cards hover effect
            const infoCards = document.querySelectorAll('.info-card');
            infoCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-3px)';
                    this.style.boxShadow = '0 8px 20px rgba(255, 46, 46, 0.25)';
                });
                
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = '0 5px 15px rgba(255, 46, 46, 0.2)';
                });
            });
        });

        // Modal functions
        function openModal(type) {
            if (type === 'username') {
                document.getElementById('usernameModal').classList.add('active');
                document.getElementById('newUsername').focus();
                document.getElementById('newUsername').select();
            } else if (type === 'password') {
                document.getElementById('passwordModal').classList.add('active');
                document.getElementById('newPassword').focus();
            }
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
            if (modalId === 'passwordModal') {
                document.getElementById('passwordForm').reset();
            }
        }

        // Close modal when clicking outside
        document.addEventListener('click', function(event) {
            const modals = document.querySelectorAll('.modal.active');
            modals.forEach(modal => {
                if (event.target === modal) {
                    modal.classList.remove('active');
                    document.getElementById('passwordForm').reset();
                }
            });
        });

        // Form validation
        document.getElementById('passwordForm').addEventListener('submit', function(e) {
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            
            if (newPassword !== confirmPassword) {
                e.preventDefault();
                alert('❌ New password and confirmation do not match!');
                document.getElementById('confirmPassword').focus();
                return false;
            }
            
            if (newPassword.length < 6) {
                e.preventDefault();
                alert('❌ Password must be at least 6 characters long!');
                document.getElementById('newPassword').focus();
                return false;
            }
            
            return true;
        });

        document.getElementById('usernameForm').addEventListener('submit', function(e) {
            const username = document.getElementById('newUsername').value;
            const usernamePattern = /^[a-zA-Z0-9_]+$/;
            
            if (!usernamePattern.test(username)) {
                e.preventDefault();
                alert('❌ Username can only contain letters, numbers, and underscores!');
                document.getElementById('newUsername').focus();
                return false;
            }
            
            if (username.length < 3 || username.length > 50) {
                e.preventDefault();
                alert('❌ Username must be between 3 and 50 characters!');
                document.getElementById('newUsername').focus();
                return false;
            }
            
            if (username === '{{ app.user.username }}') {
                e.preventDefault();
                alert('❌ New username cannot be the same as your current username!');
                document.getElementById('newUsername').focus();
                return false;
            }
            
            return true;
        });

        // Close modals with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal('usernameModal');
                closeModal('passwordModal');
            }
        });
    </script>
{% endblock %}