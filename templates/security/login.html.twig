{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/styles/global/login.css">
{% endblock %}

{% block body %}
<div class="login">
  {# left side panel #}
  <div class="login-left_panel">
    <div class="logo-inline">
      <h1>INFERN</h1>
      <img src="{{ asset('images/logo_1.png') }}" alt="Inferno Flame Logo" class="logo-inline-image">
    </div>
    <p>GAMES</p>
  </div>

  {# right side panel #}
  <div class="login-right_panel">
    <div class="login-container" role="main" aria-labelledby="login-heading">
      <div class="login-header">
        <h1 id="login-heading">WELCOME BACK</h1>
        <div class="login-intro">
          <p>Sign in to your account</p>
        </div>
      </div>

      {% if error %}
        <div class="alert alert-danger">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
      {% endif %}

      {% if app.session.get('oauth_error') %}
        <div class="alert alert-danger">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          {{ app.session.get('oauth_error') }}
          {% set _ = app.session.remove('oauth_error') %}
        </div>
      {% endif %}

      <form class="login-form" method="POST" action="{{ path('app_login') }}">
        <div class="login-row">
          <label for="username">Username</label>
          <div class="input-wrapper">
            <span class="input-icon">👤</span>
            <input id="username" name="username" type="text" placeholder="Enter your username" value="{{ last_username }}" required>
          </div>
        </div>

        <div class="login-row">
          <label for="password">Password</label>
          <div class="input-wrapper">
            <span class="input-icon">🔒</span>
            <input id="password" name="password" type="password" placeholder="••••••••" required>
            <button type="button" class="password-toggle" aria-label="Show/hide password">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="button" type="submit">
          <span>Sign In</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>

        <div class="register-link">
          <p>Don't have an account? <a href="{{ path('app_register') }}">Create an account</a></p>
        </div>

        <div class="divider">
          <span>OR</span>
        </div>

        <a href="{{ path('app_staff_google_auth') }}" class="google-login-btn">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" class="google-icon">
          Login with Google (Staff Only)
        </a>
        <div class="google-note">Only staff email domains are allowed</div>

        <div class="helper">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4M12 8h.01"/>
          </svg>
          Contact your administrator if you need staff access
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}

