    <section class="ig-about-closing ig-section" aria-labelledby="closing-heading">
        <h2 id="closing-heading" class="ig-visually-hidden">Get started</h2>
        <div class="ig-about-closing__inner">
            <p class="ig-about-closing__tagline">Ready to browse or need help?</p>
            <div class="ig-about-closing__actions">
                {# <a class="ig-btn-hero ig-btn-hero--primary" href="{{ path('app_product_index') }}">Shop games</a> #}
                <a class="ig-btn-hero ig-btn-hero--ghost" href="{{ path('app_contact_page') }}">Contact support</a>
                <a class="ig-btn-hero ig-btn-hero--ghost" href="{{ path('app_landing_page') }}">Back to home</a>
            </div>
        </div>
    </section>
</main>
