{% extends 'reusable/final_layout.html.twig' %}

{% block title %}{{ game_management.title }} | Game Details{% endblock %}

{% block body_class %}gameManagement-Show-page{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('show_gameManagement') }}
{% endblock %}

{% block content %}
<div class="game-show-container">
    <!-- Header Section -->
    <div class="show-header">
        <div class="show-header-left">
            <h1 class="game-title">{{ game_management.title }}</h1>
            <p class="game-id">#{{ game_management.id }}</p>
        </div>
        <div class="show-header-right">
            <a href="{{ path('app_game_management_index') }}" class="btn-secondary">Back to list</a>
            <a href="{{ path('app_game_management_edit', {'id': game_management.id}) }}" class="btn-primary">Edit</a>
            {{ include('Admin/game_management/_delete_form.html.twig') }}
        </div>
    </div>

    <!-- Main Content -->
    <div class="game-details-card">
        <div class="game-info">
                <div class="game-image-section w-56 h-56 rounded-lg overflow-hidden border border-gray-700 bg-gray-900 flex items-center justify-center mb-6 shadow-md">
                    {% if game_management.image %}
                        <a href="{{ asset('images/games/' ~ game_management.image) }}" target="_blank" class="block w-full h-full">
                            <img 
                                src="{{ asset('images/games/' ~ game_management.image) }}" 
                                alt="{{ game_management.title }}" 
                                class="object-cover w-full h-full transition-transform duration-200 hover:scale-105"
                            >
                        </a>
                    {% else %}
                        <div class="image-placeholder text-gray-500 flex flex-col items-center justify-center w-full h-full">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <p class="text-sm text-gray-400">No image available</p>
                        </div>
                    {% endif %}
            </div>


            <div class="game-meta">
                <div class="detail-item">
                    <h4>Description</h4>
                    <p>{{ game_management.description }}</p>
                </div>

                <div class="detail-item">
                    <h4>Price</h4>
                    <span class="price-tag">${{ game_management.price|number_format(2) }}</span>
                </div>

                <div class="detail-item">
                    <h4>Stock</h4>
                    {% if game_management.stock %}
                        <div class="stock-info">
                            <span><strong>Available:</strong> {{ game_management.stock.availableQuantity }}</span>
                            <span><strong>Total:</strong> {{ game_management.stock.totalQuantity }}</span>
                            <span><strong>Status:</strong> {{ game_management.stock.status }}</span>
                            {% set percentage = (game_management.stock.availableQuantity / game_management.stock.totalQuantity * 100)|round %}
                            <div class="stock-bar">
                                <div class="stock-fill" style="width: {{ percentage }}%"></div>
                            </div>
                        </div>
                    {% else %}
                        <em>No stock linked</em>
                    {% endif %}
                </div>

                <div class="detail-item">
                    <h4>License Keys</h4>
                    {% if game_management.licenseKeys is not empty %}
                        <ul class="key-list">
                            {% for key in game_management.licenseKeys %}
                                <li class="key-item">
                                    <span class="key-code">{{ key.code }}</span> 
                                    <span class="key-status">{{ key.status }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <em>No license keys yet</em>
                    {% endif %}
                </div>

                <div class="detail-item">
                    <h4>Orders</h4>
                    {% if game_management.orders is not empty %}
                        <ul class="order-list">
                            {% for order in game_management.orders %}
                                <li class="order-item">
                                    <span class="order-number">#{{ order.orderNumber }}</span>
                                    <span class="order-status">{{ order.status }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <em>No orders yet</em>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
