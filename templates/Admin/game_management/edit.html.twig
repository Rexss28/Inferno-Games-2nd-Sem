{% extends 'reusable/final_layout.html.twig' %}

{% block title %}Edit Game Management{% endblock %}
{% block body_class %}gameManagement-edit-page{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('game_edit') }}
{% endblock %}

{% block content %}
<div class="game-edit-container">
  <div class="edit-header">
    <h1>Edit Game</h1>
  </div>

  <div class="edit-form-card">
    {{ include('Admin/game_management/_form.html.twig', {'button_label': 'Update'}) }}
  </div>

  <div class="edit-actions">
    <a href="{{ path('app_game_management_index') }}" class="btn-secondary">Back</a>
    {{ include('Admin/game_management/_delete_form.html.twig') }}
  </div>
</div>
{% endblock %}
