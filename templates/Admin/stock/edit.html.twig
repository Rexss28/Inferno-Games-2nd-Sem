{% extends 'reusable/final_layout.html.twig' %}

{% block title %}Edit Stock{% endblock %}

{% block body_class %}stock-edit-page{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('stock_edit') }}
{% endblock %}

{% block content %}
<div class="stock-edit-container">
  <!-- Header -->
  <div class="edit-header">
    <h1>Edit Stock</h1>
  </div>

  <!-- Main Content -->
  <div class="edit-main-content">
    <!-- Left: Form -->
    <div class="edit-form-section">
      <div class="edit-form-card">
        {{ form_start(form, {'attr': {'class': 'edit-form'}}) }}
          <!-- Total Quantity -->
          <div class="form-group">
            {{ form_label(form.totalQuantity, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.totalQuantity, {'attr': {
              'class': 'form-input',
              'min': '1',
              'required': true
            }}) }}
            {{ form_errors(form.totalQuantity) }}
          </div>

          <!-- Available Quantity -->
          <div class="form-group">
            {{ form_label(form.availableQuantity, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.availableQuantity, {'attr': {
              'class': 'form-input',
              'min': '0',
              'required': true
            }}) }}
            {{ form_errors(form.availableQuantity) }}
          </div>

          <!-- Game -->
          <div class="form-group">
            {{ form_label(form.game, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.game, {'attr': {
              'class': 'form-input'
            }}) }}
            {{ form_errors(form.game) }}
          </div>

          <!-- Submit Button -->
          <button type="submit" class="primary-action">
            Update Stock
          </button>
        {{ form_end(form) }}
      </div>
    </div>

    <!-- Right: Preview & Actions -->
    <div class="edit-preview-section">
      <!-- Preview Card -->
      <div class="preview-card">
        <div class="preview-header">
          <h3>Current Stock</h3>
        </div>
        <div class="preview-content">
          <div class="preview-item">
            <div class="preview-label">Stock ID</div>
            <div class="preview-value">#{{ stock.id }}</div>
          </div>
          <div class="preview-item">
            <div class="preview-label">Total Quantity</div>
            <div class="preview-value">{{ stock.totalQuantity }} units</div>
          </div>
          <div class="preview-item">
            <div class="preview-label">Available Quantity</div>
            <div class="preview-value">{{ stock.availableQuantity }} units</div>
          </div>
          <div class="preview-item">
            <div class="preview-label">Status</div>
            <div class="preview-value">{{ stock.status }}</div>
          </div>
          {% if stock.game %}
          <div class="preview-item">
            <div class="preview-label">Associated Game</div>
            <div class="preview-value">{{ stock.game.title }}</div>
          </div>
          {% endif %}
          {% if stock.createdBy %}
          <div class="preview-item">
            <div class="preview-label">Created By</div>
            <div class="preview-value">{{ stock.createdBy.username }}</div>
          </div>
          {% endif %}
        </div>
      </div>

      <!-- Actions -->
      <div class="edit-actions">
        <a href="{{ path('app_stock_index') }}" class="btn-secondary">Back to list</a>
        
        <!-- Inline Delete Form (same as game edit template) -->
        <form method="post" action="{{ path('app_stock_delete', {'id': stock.id}) }}" 
              class="delete-form" onsubmit="return confirm('Are you sure you want to delete this stock?');">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
          <button type="submit" class="delete-action">
            Delete Stock
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}