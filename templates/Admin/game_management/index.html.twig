{% extends 'reusable/final_layout.html.twig' %}

{% block title %}Game Management{% endblock %}
{% block body_class %}gameManagement-Index-page{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
  {{ encore_entry_link_tags('index') }}

  <style>
    /* 🎨 Dark Mode Styling for DataTables */
    table.dataTable {
        color: #fff;
        background-color: #2E2E2E;
        border-radius: 0.75rem;
        width: 100% !important;
    }

    table.dataTable thead {
        background: #1a1a1a;
    }

    table.dataTable thead th {
        color: #B3B3B3;
        border-bottom: 2px solid #FF2E2E !important;
        font-weight: 600;
    }

    table.dataTable tbody tr:hover {
        background-color: rgba(255, 46, 46, 0.08);
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        background: #1a1a1a !important;
        color: #fff !important;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 6px;
        margin: 0 2px;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #FF2E2E, #FF6B2E) !important;
        color: #fff !important;
    }

    .dataTables_wrapper .dataTables_filter input {
        background: #1a1a1a;
        border: 1px solid rgba(255,255,255,0.1);
        color: #fff;
        padding: 0.35rem 0.5rem;
        border-radius: 6px;
    }

    .dataTables_wrapper .dataTables_length select {
        background: #1a1a1a;
        color: #fff;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 6px;
    }

    .game-image-wrapper {
        width: 3rem;
        height: 3rem;
        border-radius: 6px;
        overflow: hidden;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #111;
        margin-right: 0.5rem;
    }

    .game-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .game-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .game-title {
        font-weight: 500;
        color: #fff;
    }

    /* Hide the original content and use data-sort attribute */
    .sort-data {
        display: none;
    }

    /* ✅ Fix DataTables layout without horizontal scrollbar */
    .dataTables_wrapper {
        overflow-x: hidden !important;
    }

    .table-container,
    .table-wrapper {
        width: 100%;
        overflow-x: hidden;
    }

    /* Ensure table fits neatly in the wrapper */
    .games-table {
        table-layout: auto;
        width: 100% !important;
        white-space: nowrap;
    }

    /* Prevent last column (Actions) from overflowing */
    .games-table td:last-child,
    .games-table th:last-child {
        width: 1%;
        white-space: nowrap;
    }

    /* Slightly reduce padding to prevent overflow */
    .games-table th,
    .games-table td {
        padding: 0.65rem 0.75rem;
    }

    /* Security-aware buttons */
    .btn-action.disabled {
        opacity: 0.5;
        cursor: not-allowed !important;
    }

    .btn-action.disabled:hover {
        transform: none !important;
        box-shadow: none !important;
    }

    /* Creator info styling */
    .creator-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        position: relative;
    }

    .creator-name {
        font-weight: 500;
        color: #ecf0f1;
    }

    .creator-username {
        font-size: 0.8rem;
        color: #95a5a6;
    }

    .badge-you {
        position: absolute;
        top: -5px;
        right: -5px;
        background: linear-gradient(135deg, #FF2E2E, #FF6B2E);
        color: white;
        font-size: 0.6rem;
        padding: 1px 5px;
        border-radius: 10px;
        font-weight: bold;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .btn-action {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        font-size: 1rem;
    }

    .btn-view {
        background: #2c2c2c;
        color: #3498db;
    }

    .btn-view:hover {
        background: #3498db;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
    }

    .btn-edit {
        background: #2c2c2c;
        color: #f39c12;
    }

    .btn-edit:hover {
        background: #f39c12;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(243, 156, 18, 0.3);
    }

    .btn-delete {
        background: #2c2c2c;
        color: #e74c3c;
    }

    .btn-delete:hover {
        background: #e74c3c;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
    }

    /* Minimalist Confirmation Modal */
    .confirmation-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: 9999;
      align-items: center;
      justify-content: center;
    }

    .confirmation-modal.active {
      display: flex;
    }

    .confirmation-modal-content {
      background: #1a1a1a;
      border-radius: 12px;
      padding: 32px;
      max-width: 400px;
      width: 90%;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    }

    .confirmation-modal-icon {
      width: 48px;
      height: 48px;
      background: rgba(255, 46, 46, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      color: #FF2E2E;
      font-size: 24px;
    }

    .confirmation-modal-title {
      color: #fff;
      font-size: 20px;
      font-weight: 600;
      text-align: center;
      margin-bottom: 12px;
    }

    .confirmation-modal-message {
      color: #B3B3B3;
      text-align: center;
      line-height: 1.5;
      margin-bottom: 16px;
    }

    .confirmation-modal-details {
      background: rgba(255, 255, 255, 0.05);
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 20px;
      border-left: 3px solid #FF2E2E;
    }

    .confirmation-modal-detail-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
      font-size: 0.9rem;
    }

    .confirmation-modal-detail-label {
      color: #B3B3B3;
    }

    .confirmation-modal-detail-value {
      color: #fff;
      font-weight: 500;
    }

    .confirmation-modal-warning {
      color: #FF6B2E;
      font-size: 0.9rem;
      text-align: center;
      padding: 8px;
      background: rgba(255, 107, 46, 0.1);
      border-radius: 6px;
      margin-bottom: 20px;
    }

    .confirmation-modal-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
    }

    .confirmation-modal-btn {
      padding: 10px 24px;
      border-radius: 8px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: all 0.2s ease;
      min-width: 100px;
    }

    .confirmation-modal-cancel {
      background: rgba(255, 255, 255, 0.05);
      color: #B3B3B3;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .confirmation-modal-cancel:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .confirmation-modal-confirm {
      background: linear-gradient(135deg, #FF2E2E, #FF6B2E);
      color: white;
    }

    .confirmation-modal-confirm:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }
  </style>
{% endblock %}

{% block content %}
<div class="game-management-container">
    <!-- Minimalist Confirmation Modal -->
    <div class="confirmation-modal" id="confirmationModal">
      <div class="confirmation-modal-content">
        <div class="confirmation-modal-icon">🗑️</div>
        <h3 class="confirmation-modal-title">Delete Game</h3>
        <p class="confirmation-modal-message" id="confirmationMessage">
          Are you sure you want to delete this game? This action cannot be undone.
        </p>
        
        <div class="confirmation-modal-details">
          <div class="confirmation-modal-detail-item">
            <span class="confirmation-modal-detail-label">Game:</span>
            <span class="confirmation-modal-detail-value" id="deleteGameTitle"></span>
          </div>
          <div class="confirmation-modal-detail-item">
            <span class="confirmation-modal-detail-label">ID:</span>
            <span class="confirmation-modal-detail-value" id="deleteGameId"></span>
          </div>
          <div class="confirmation-modal-detail-item">
            <span class="confirmation-modal-detail-label">License Keys:</span>
            <span class="confirmation-modal-detail-value" id="deleteGameKeys">0</span>
          </div>
          <div class="confirmation-modal-detail-item">
            <span class="confirmation-modal-detail-label">Orders:</span>
            <span class="confirmation-modal-detail-value" id="deleteGameOrders">0</span>
          </div>
        </div>
        
        <div class="confirmation-modal-warning" id="confirmationWarning">
          ⚠️ This game has active license keys and/or orders. Deleting it will remove all associated data.
        </div>
        
        <div class="confirmation-modal-actions">
          <button class="confirmation-modal-btn confirmation-modal-cancel" id="cancelBtn">
            Cancel
          </button>
          <button class="confirmation-modal-btn confirmation-modal-confirm" id="confirmBtn">
            Delete
          </button>
        </div>
      </div>
    </div>

    <!-- Header -->
    <div class="header-section">
        <div class="header-content">
            <h1 class="page-title">Game Management</h1>
        </div>
        <a href="{{ path('app_game_management_new') }}" class="btn-primary">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add New Game
        </a>
    </div>

    <!-- Table -->
    <div class="table-container">
        <div class="table-wrapper">
            <table id="myTable" class="games-table display">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Game</th>
                        <th>Description</th>
                        <th>Created By</th> 
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Keys</th>
                        <th>Orders</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for game_management in game_managements %}
                    <tr>
                        <td data-sort="{{ game_management.id }}">#{{ game_management.id }}</td>
                        <td data-search="{{ game_management.title|lower }}">
                            <div class="game-info">
                                <div class="game-image-wrapper">
                                    {% if game_management.image %}
                                        <img src="{{ asset('images/games/' ~ game_management.image) }}" alt="{{ game_management.title }}">
                                    {% else %}
                                        <div class="game-image-placeholder text-gray-500 flex items-center justify-center w-full h-full">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                        </div>
                                    {% endif %}
                                </div>
                                <span class="game-title">{{ game_management.title }}</span>
                                <!-- Hidden sort data -->
                                <span class="sort-data">{{ game_management.title|lower }}</span>
                            </div>
                        </td>
                        <td>{{ game_management.description|u.truncate(60) }}</td>
                        <td data-search="{{ game_management.createdBy ? game_management.createdBy.username|lower : 'unknown' }}">
                            {% if game_management.createdBy %}
                                <div class="creator-info">
                                    <div class="creator-name">
                                        {{ game_management.createdBy.username }}
                                    </div>
                                </div>
                            {% else %}
                                <span class="text-muted">Unknown</span>
                            {% endif %}
                        </td>
                        <td>${{ game_management.price|number_format(2) }}</td>
                        <td data-sort="{{ game_management.stock ? game_management.stock.availableQuantity : 0 }}">
                            {% if game_management.stock %}
                                {{ game_management.stock.availableQuantity }}/{{ game_management.stock.totalQuantity }}
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                        <td data-sort="{{ game_management.licenseKeys|length }}">{{ game_management.licenseKeys|length }}</td>
                        <td data-sort="{{ game_management.orders|length }}">{{ game_management.orders|length }}</td>
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('app_game_management_show', {'id': game_management.id}) }}" 
                                   class="btn-action btn-view" 
                                   title="View Details">
                                    👁️
                                </a>
                                <a href="{{ path('app_game_management_edit', {'id': game_management.id}) }}" 
                                   class="btn-action btn-edit {% if not is_granted('EDIT', game_management) %}disabled{% endif %}" 
                                   title="Edit Game"
                                   {% if not is_granted('EDIT', game_management) %}onclick="return false;" style="opacity: 0.5; cursor: not-allowed;"{% endif %}>
                                    ✏️
                                </a>
                                <form method="post" 
                                      action="{{ path('app_game_management_delete', {'id': game_management.id}) }}" 
                                      class="d-inline delete-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ game_management.id) }}">
                                    <button type="button" 
                                            class="btn-action btn-delete {% if not is_granted('DELETE', game_management) %}disabled{% endif %} delete-btn" 
                                            title="Delete Game"
                                            data-game-id="{{ game_management.id }}"
                                            data-game-title="{{ game_management.title }}"
                                            data-game-keys="{{ game_management.licenseKeys|length }}"
                                            data-game-orders="{{ game_management.orders|length }}"
                                            {% if not is_granted('DELETE', game_management) %}disabled style="opacity: 0.5; cursor: not-allowed;"{% endif %}>
                                        🗑️
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <!-- ✅ jQuery first -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <!-- ✅ DataTables (jQuery version) -->
  <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

  <script>
    $(document).ready(function () {
        // DataTable initialization
        if (!$.fn.DataTable.isDataTable('#myTable')) {
            $('#myTable').DataTable({
                pageLength: 10,
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search games, creator..."
                },
                columnDefs: [
                    { targets: 0, type: 'num' },
                    { targets: 1, type: 'string' },
                    { targets: 2, type: 'string' },
                    { targets: 3, type: 'string' },
                    { 
                        targets: 4,
                        type: 'num',
                        render: function(data, type, row) {
                            if (type === 'sort' || type === 'type') {
                                return parseFloat(data.replace('$', '').replace(/,/g, ''));
                            }
                            return data;
                        }
                    },
                    { targets: 5, type: 'num' },
                    { targets: 6, type: 'num' },
                    { targets: 7, type: 'num' },
                    { targets: 8, orderable: false, searchable: false }
                ],
                order: [[0, 'asc']]
            });
            console.log("✅ DataTable initialized successfully!");
        }

        // Minimalist confirmation modal logic
        const confirmationModal = $('#confirmationModal');
        const confirmationMessage = $('#confirmationMessage');
        const confirmationWarning = $('#confirmationWarning');
        const deleteGameTitle = $('#deleteGameTitle');
        const deleteGameId = $('#deleteGameId');
        const deleteGameKeys = $('#deleteGameKeys');
        const deleteGameOrders = $('#deleteGameOrders');
        const cancelBtn = $('#cancelBtn');
        const confirmBtn = $('#confirmBtn');
        
        let formToSubmit = null;

        // Handle delete button click
        $(document).on('click', '.delete-btn:not(.disabled)', function(e) {
            e.preventDefault();
            
            const gameId = $(this).data('game-id');
            const gameTitle = $(this).data('game-title');
            const keysCount = $(this).data('game-keys');
            const ordersCount = $(this).data('game-orders');
            
            formToSubmit = $(this).closest('form');
            
            // Update modal content
            deleteGameTitle.text(gameTitle);
            deleteGameId.text('#' + gameId);
            deleteGameKeys.text(keysCount);
            deleteGameOrders.text(ordersCount);
            
            // Show warning if there are keys or orders
            if (keysCount > 0 || ordersCount > 0) {
                confirmationWarning.show();
            } else {
                confirmationWarning.hide();
            }
            
            // Show modal
            confirmationModal.addClass('active');
        });

        // Handle cancel button
        cancelBtn.on('click', function() {
            confirmationModal.removeClass('active');
            formToSubmit = null;
        });

        // Handle confirm button
        confirmBtn.on('click', function() {
            if (formToSubmit) {
                formToSubmit.submit();
            }
            confirmationModal.removeClass('active');
            formToSubmit = null;
        });

        // Close modal when clicking outside
        confirmationModal.on('click', function(e) {
            if (e.target === this) {
                confirmationModal.removeClass('active');
                formToSubmit = null;
            }
        });

        // Close modal with Escape key
        $(document).on('keydown', function(e) {
            if (e.key === 'Escape' && confirmationModal.hasClass('active')) {
                confirmationModal.removeClass('active');
                formToSubmit = null;
            }
        });
    });
  </script>
{% endblock %}