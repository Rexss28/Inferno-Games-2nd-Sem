<main class="ig-contact-page" id="ig-main">
    <section class="ig-contact-hero" aria-labelledby="contact-hero-heading">
        <div class="ig-contact-hero__bg"></div>
        <div class="ig-contact-hero__inner">
            <p class="ig-contact-hero__eyebrow">Support</p>
            <h1 id="contact-hero-heading" class="ig-contact-hero__title">We are here when something breaks — or when you are ready to play</h1>
            <p class="ig-contact-hero__lead">Messages are delivered securely via our mail stack. If you use <strong>email sign-in or the API</strong>, your account must be <strong>email-verified</strong>. <strong>Google sign-in</strong> uses your verified Google identity — use the same email below so we can match your ticket to your Inferno account.</p>
        </div>
    </section>

    {# <section class="ig-contact-account-strip" aria-labelledby="account-signin-heading">
        <div class="ig-contact-account-strip__inner">
            <div class="ig-contact-account-strip__copy">
                <h2 id="account-signin-heading" class="ig-contact-account-strip__title">Account, API &amp; Google</h2>
                {% if app.user %}
                    <p class="ig-contact-account-strip__text">You are signed in as <strong>{{ app.user.userIdentifier }}</strong>. If this is the wrong account, sign out and use Google or email login below. Include the same email in the form so support can match your ticket.</p>
                {% else %}
                    <p class="ig-contact-account-strip__text"><strong>Email verification</strong> is required for password-based and API login. <strong>Google OAuth</strong> signs you in with a Google-verified email in one step. Pick what fits you — then reach out here if something still misbehaves.</p>
                {% endif %}
            </div>
            <div class="ig-contact-account-strip__actions">
                {% if app.user %}
                    <a class="ig-contact-pill" href="{{ path('app_logout') }}">Sign out</a>
                {% else %}
                    <a class="ig-contact-pill" href="{{ path('app_login') }}">Sign in</a>
                    <a class="ig-contact-pill" href="{{ path('app_register') }}">Register</a>
                {% endif %}
                <a class="ig-contact-google" href="{{ path('app_google_auth') }}">
                    <span class="ig-contact-google__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                    </span>
                    Continue with Google
                </a>
            </div>
        </div>
    </section> #}

    <section class="ig-section">
        {% for message in app.flashes('success') %}
            <div class="ig-flash ig-flash--success" role="status">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="ig-flash ig-flash--error" role="alert">{{ message }}</div>
        {% endfor %}

        {% if form.vars.submitted and not form.vars.valid %}
            <div class="ig-flash ig-flash--error" role="alert">Please correct the fields below and try again.</div>
        {% endif %}

        <div class="ig-contact-layout">
            <div class="ig-contact-aside">
                <h2 class="ig-contact-aside__title">Before you write</h2>
                <ul class="ig-contact-aside__list">
                    <li>
                        <span class="ig-contact-aside__label">Verified email &amp; API</span>
                        <span class="ig-contact-aside__value">Password and API login require a verified email. Didn’t get the link? Check spam, then contact us from the same address you registered.</span>
                    </li>
                    <li>
                        <span class="ig-contact-aside__label">Google sign-in</span>
                        <span class="ig-contact-aside__value">Signing in with Google links your Google-verified email to Inferno automatically — no separate verification step.</span>
                    </li>
                    <li>
                        <span class="ig-contact-aside__label">Response time</span>
                        <span class="ig-contact-aside__value">We aim to reply within one business day for coursework and store questions.</span>
                    </li>
                    <li>
                        <span class="ig-contact-aside__label">Client &amp; installs</span>
                        <span class="ig-contact-aside__value">See the Inferno Client section on the home page for download and install tips.</span>
                    </li>
                </ul>

                {# <div class="ig-contact-rubric" id="rubric">
                    <h3 class="ig-contact-rubric__title">Platform Technology midterm (rubric reminders)</h3>
                    <p class="ig-contact-rubric__text">If your message is for an instructor or TA, mention that your app is deployed on a <strong>Linux VM</strong>, uses the <strong>hosted database</strong> (not localhost), includes a custom entity with working <strong>CRUD</strong>, and your <strong>video</strong> shows live CRUD plus proof in the hosted DB — that lines up with the 80-point rubric checklist.</p>
                </div> #}

                <a class="ig-contact-aside__link" href="{{ path('app_about_page') }}">About Inferno Games</a>
                <a class="ig-contact-aside__link" href="{{ path('app_landing_page') }}">Back to store home</a>
            </div>

            <div class="ig-contact-form-wrap">
                <h2 class="ig-contact-form__heading">Send a message</h2>
                <p class="ig-contact-form__hint">All fields are required. Submissions are validated server-side (Symfony Form + CSRF) and sent securely to our inbox. Use the <strong>same email as your Inferno account</strong> when possible so we can match your message to your profile.</p>

                {{ form_start(form, {
                    attr: { class: 'ig-contact-form', id: 'contact-form', novalidate: 'novalidate' }
                }) }}
                    {{ form_row(form.name) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.subject) }}
                    {{ form_row(form.message) }}

                    <div class="ig-contact-form__actions">
                        <button type="submit" class="ig-btn-hero ig-btn-hero--primary">Send message</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </section>
</main>
