{% extends 'reusable/final_layout.html.twig' %}

{% block title %}Admin Dashboard | Inferno Games{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('admin_dashboard') }}
{% endblock %}

{% block content %}
<div class="dashboard-container">
    <!-- Header Section -->
    <div class="dashboard-header">
        <div>
            <h1 class="dashboard-title">Admin Dashboard</h1>
            <p class="dashboard-subtitle">Welcome back, {{ app.user.name ?? app.user.email }}</p>
        </div>
        <div class="header-badge">
            <span class="pulse-dot"></span>
            Live Dashboard
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="kpi-card kpi-indigo">
            <div class="kpi-icon">🎮</div>
            <div class="kpi-content">
                <p class="kpi-label">Total Games</p>
                <p class="kpi-value">{{ totalGames }}</p>
                <div class="kpi-trend">
                    <span class="trend-up">↑ Active Games</span>
                </div>
            </div>
        </div>
        
        <div class="kpi-card kpi-blue">
            <div class="kpi-icon">👥</div>
            <div class="kpi-content">
                <p class="kpi-label">Total Users</p>
                <p class="kpi-value">{{ totalUsers }}</p>
                <div class="kpi-trend">
                    <span class="trend-up">↑ Registered</span>
                </div>
            </div>
        </div>
        
        <div class="kpi-card kpi-yellow">
            <div class="kpi-icon">🛡️</div>
            <div class="kpi-content">
                <p class="kpi-label">Total Staff</p>
                <p class="kpi-value">{{ totalStaff }}</p>
                <div class="kpi-trend">
                    <span class="trend-neutral">→ Team Members</span>
                </div>
            </div>
        </div>
        
        <div class="kpi-card kpi-emerald">
            <div class="kpi-icon">💰</div>
            <div class="kpi-content">
                <p class="kpi-label">Total Revenue</p>
                <p class="kpi-value">${{ totalRevenue|number_format(2, '.', ',') }}</p>
                <div class="kpi-trend">
                    <span class="trend-up">↑ Growing</span>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="action-section">
        <div class="section-header">
            <div>
                <h2 class="section-title">Quick Actions</h2>
                <p class="section-subtitle">Streamline your workflow</p>
            </div>
        </div>
        <div class="action-grid">
            <a href="{{ path('app_game_management_new') }}" class="action-btn action-indigo">
                <span class="action-icon">➕</span>
                <span class="action-text">Add New Game</span>
            </a>
            <a href="{{ path('app_stock_new') }}" class="action-btn action-blue">
                <span class="action-icon">📦</span>
                <span class="action-text">Add Stock</span>
            </a>
            <a href="{{ path('app_license_key_new') }}" class="action-btn action-purple">
                <span class="action-icon">🔑</span>
                <span class="action-text">Add License Key</span>
            </a>
            <a href="{{ path('app_order_index') }}" class="action-btn action-emerald">
                <span class="action-icon">📋</span>
                <span class="action-text">View Orders</span>
            </a>
        </div>
    </div>

    <!-- RECENT ACTIVITY LOGS (FULL WIDTH) -->
    <div class="alert-section">
        <div class="section-header">
            <div>
                <h2 class="section-title section-title-blue">📋 Recent Activity Logs</h2>
                <p class="section-subtitle">Latest system activities</p>
            </div>
            <a href="{{ path('activity_log_index') }}" class="view-all-link">
                View All Logs →
            </a>
        </div>
        
        {% if recentActivityLogs is not empty %}
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Action</th>
                            <th>Target Data</th>
                            <th>Date/Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in recentActivityLogs %}
                            <tr class="table-row-hover">
                                <td>
                                    <span class="user-name">{{ log.username }}</span>
                                </td>
                                <td>
                                    <span class="badge 
                                        {% if log.role == 'ROLE_ADMIN' %}badge-danger
                                        {% elseif log.role == 'ROLE_STAFF' %}badge-warning
                                        {% else %}badge-secondary{% endif %}">
                                        {{ log.role|replace({'ROLE_': ''}) }}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge 
                                        {% if log.action == 'CREATE' %}badge-success
                                        {% elseif log.action == 'UPDATE' %}badge-info
                                        {% elseif log.action == 'DELETE' %}badge-danger
                                        {% elseif log.action == 'LOGIN' %}badge-primary
                                        {% elseif log.action == 'LOGOUT' %}badge-secondary
                                        {% else %}badge-light{% endif %}">
                                        {{ log.action }}
                                    </span>
                                </td>
                                <td class="log-target">
                                    {{ log.targetData|length > 50 ? log.targetData|slice(0, 50) ~ '...' : log.targetData }}
                                </td>
                                <td>
                                    <span class="log-time">
                                        {{ log.createdAt|date('Y-m-d H:i:s') }}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="text-center mt-3">
                <a href="{{ path('activity_log_index') }}" class="btn btn-outline-primary">
                    View All Activity Logs →
                </a>
            </div>
        {% else %}
            <div class="empty-state">
                <div class="empty-icon">📊</div>
                <p class="empty-text">No activity logs yet</p>
                <p class="empty-subtext">System activities will appear here</p>
            </div>
        {% endif %}
    </div>

    <!-- TWO COLUMN GRID FOR LOW STOCK & RECENT GAMES -->
    <div class="activity-grid">
        <!-- Low Stock Alert Card -->
        <div class="activity-card">
            <div class="section-header">
                <div>
                    <h2 class="section-title section-title-alert">⚠️ Low Stock Alerts</h2>
                    <p class="section-subtitle">Items requiring attention</p>
                </div>
                <a href="{{ path('app_stock_index') }}" class="view-all-link">
                    Manage Stock →
                </a>
            </div>
            
            {% if lowStockGames is not empty %}
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Stock ID</th>
                                <th>Available</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for stock in lowStockGames %}
                                <tr class="table-row-hover">
                                    <td>
                                        <span class="stock-id">#{{ stock.id }}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-danger">{{ stock.availableQuantity }}</span>
                                    </td>
                                    <td>{{ stock.totalQuantity }}</td>
                                    <td>
                                        <span class="status-badge status-low">{{ stock.status }}</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="empty-state-compact">
                    <div class="empty-icon">✅</div>
                    <p class="empty-text">All stocks are sufficient</p>
                    <p class="empty-subtext">No action required</p>
                </div>
            {% endif %}
        </div>

        <!-- Recent Games Card -->
        <div class="activity-card">
            <div class="section-header">
                <div>
                    <h2 class="section-title section-title-indigo">🎮 Recently Added Games</h2>
                    <p class="section-subtitle">Latest games in catalog</p>
                </div>
                <a href="{{ path('app_game_management_index') }}" class="view-all-link">
                    View All Games →
                </a>
            </div>
            
            {% if recentGames is not empty %}
                <ul class="game-list">
                    {% for game in recentGames %}
                        <li class="game-item">
                            <div class="game-info-wrapper">
                                <div class="game-thumb">
                                    {% if game.image %}
                                        <img 
                                            src="{{ asset('images/games/' ~ game.image) }}" 
                                            alt="{{ game.title }}"
                                            loading="lazy"
                                        >
                                    {% else %}
                                        <div class="image-placeholder">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20">
                                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="game-info">
                                    <span class="game-title-text">{{ game.title }}</span>
                                    <span class="game-id">ID: {{ game.id }}</span>
                                </div>
                            </div>
                            <div class="game-badge">New</div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <div class="empty-state-compact">
                    <p class="empty-text">No recent games added</p>
                    <p class="empty-subtext">Click "Add New Game" to get started</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // Optional: Auto-refresh dashboard data every 30 seconds
    if (typeof window.autoRefreshEnabled !== 'undefined' && window.autoRefreshEnabled) {
        setInterval(function() {
            location.reload();
        }, 30000);
    }
</script>
{% endblock %}