{% extends 'reusable/layout.html.twig' %}
{% block body_class %}product-page-show{% endblock %}
{% block title %}Product{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('show') }}
{% endblock %}


{% block content %}
   <h1>Show Product</h1>

<table class="table product-details">
    <tbody>
        <tr>
            <th>Id</th>
            <td>{{ product.id }}</td>
        </tr>
        <tr>
            <th>Name</th>
            <td>{{ product.Name }}</td>
        </tr>
        <tr>
            <th>Price</th>
            <td>{{ product.Price }}</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>{{ product.Description }}</td>
        </tr>
    </tbody>
</table>

<div class="page-actions">
    <a href="{{ path('app_product_index') }}" class="back-link">Back to list</a>
    <a href="{{ path('app_product_edit', {'id': product.id}) }}">Edit</a>
    {{ include('/Admin/product/_delete_form.html.twig') }}
</div>

{% endblock %}
