{% extends 'reusable/final_layout.html.twig' %}

{% block title %}Edit Stock{% endblock %}

{% block body_class %}stock-edit-page{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('stock_edit') }}
{% endblock %}

{% block content %}
<div class="stock-edit-container">
  <!-- Header -->
  <div class="edit-header">
    <h1>Edit Stock</h1>
  </div>

  <!-- Form Card -->
  <div class="edit-form-card">
    {{ include('Admin/stock/_form.html.twig', {'button_label': 'Update'}) }}
  </div>

  <!-- Action Buttons -->
  <div class="edit-actions">
    <a href="{{ path('app_stock_index') }}" class="btn-secondary">Back to list</a>
    {{ include('Admin/stock/_delete_form.html.twig') }}
  </div>
</div>
{% endblock %}
