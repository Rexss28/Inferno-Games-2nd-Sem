{% extends 'reusable/final_layout.html.twig' %}

{% block title %}License Keys{% endblock %}
{% block body_class %}licenseKey-Index-page{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <!-- ✅ DataTables CSS -->
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css">
  {{ encore_entry_link_tags('key_index') }}

  <style>
    /* 🎨 Dark DataTables Theme */
    table.dataTable {
        color: #fff;
        background-color: #2E2E2E;
        border-radius: 0.75rem;
        width: 100% !important;
    }

    table.dataTable thead {
        background: #1a1a1a;
    }

    table.dataTable thead th {
        color: #B3B3B3;
        border-bottom: 2px solid #FF2E2E !important;
        font-weight: 600;
    }

    table.dataTable tbody tr:hover {
        background-color: rgba(255, 46, 46, 0.08);
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        background: #1a1a1a !important;
        color: #fff !important;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 6px;
        margin: 0 2px;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #FF2E2E, #FF6B2E) !important;
        color: #fff !important;
    }

    .dataTables_wrapper .dataTables_filter input {
        background: #1a1a1a;
        border: 1px solid rgba(255,255,255,0.1);
        color: #fff;
        padding: 0.35rem 0.5rem;
        border-radius: 6px;
    }

    .dataTables_wrapper .dataTables_length select {
        background: #1a1a1a;
        color: #fff;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 6px;
    }

    /* Security-aware buttons */
    .btn-action.disabled {
        opacity: 0.5;
        cursor: not-allowed !important;
    }

    .btn-action.disabled:hover {
        transform: none !important;
        box-shadow: none !important;
    }

    /* Minimalist Confirmation Modal */
    .confirmation-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: 9999;
      align-items: center;
      justify-content: center;
    }

    .confirmation-modal.active {
      display: flex;
    }

    .confirmation-modal-content {
      background: #1a1a1a;
      border-radius: 12px;
      padding: 32px;
      max-width: 400px;
      width: 90%;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    }

    .confirmation-modal-icon {
      width: 48px;
      height: 48px;
      background: rgba(255, 46, 46, 0.1);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      color: #FF2E2E;
      font-size: 24px;
    }

    .confirmation-modal-title {
      color: #fff;
      font-size: 20px;
      font-weight: 600;
      text-align: center;
      margin-bottom: 12px;
    }

    .confirmation-modal-message {
      color: #B3B3B3;
      text-align: center;
      line-height: 1.5;
      margin-bottom: 24px;
    }

    .confirmation-modal-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
    }

    .confirmation-modal-btn {
      padding: 10px 24px;
      border-radius: 8px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      transition: all 0.2s ease;
      min-width: 100px;
    }

    .confirmation-modal-cancel {
      background: rgba(255, 255, 255, 0.05);
      color: #B3B3B3;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .confirmation-modal-cancel:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .confirmation-modal-confirm {
      background: linear-gradient(135deg, #FF2E2E, #FF6B2E);
      color: white;
    }

    .confirmation-modal-confirm:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }
  </style>
{% endblock %}

{% block content %}
<div class="licenseKey-container">
    <!-- Minimalist Confirmation Modal -->
    <div class="confirmation-modal" id="confirmationModal">
      <div class="confirmation-modal-content">
        <div class="confirmation-modal-icon">🗑️</div>
        <h3 class="confirmation-modal-title">Delete License Key</h3>
        <p class="confirmation-modal-message" id="confirmationMessage">
          Are you sure you want to delete this license key? This action cannot be undone.
        </p>
        <div class="confirmation-modal-actions">
          <button class="confirmation-modal-btn confirmation-modal-cancel" id="cancelBtn">
            Cancel
          </button>
          <button class="confirmation-modal-btn confirmation-modal-confirm" id="confirmBtn">
            Delete
          </button>
        </div>
      </div>
    </div>

    <!-- Header Section -->
    <div class="header-section">
        <div class="header-content">
            <h1 class="page-title">License Key Management</h1>
            <p class="page-subtitle">Manage and track license keys for games</p>
        </div>
        <a href="{{ path('app_license_key_new') }}" class="btn-primary">
            <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Add New License Key
        </a>
    </div>

    <!-- Table Container -->
    <div class="table-container">
        <div class="table-wrapper">
            <table id="myTable" class="licenseKey-table display">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Code</th>
                        <th>Status</th>
                        <th>Game</th>
                        <th>Order</th>
                        <th>Created By</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for license_key in license_keys %}
                    <tr>
                        <td data-sort="{{ license_key.id }}">#{{ license_key.id }}</td>
                        <td data-search="{{ license_key.code|lower }}">
                            <span class="license-code">{{ license_key.code }}</span>
                        </td>

                        <!-- ✅ Dynamic Status Display -->
                        <td data-search="{{ license_key.status|lower }}">
                            {% set statusClass = '' %}
                            {% if license_key.status == 'Available' %}
                                {% set statusClass = 'status-available' %}
                            {% elseif license_key.status == 'Reserved' %}
                                {% set statusClass = 'status-reserved' %}
                            {% elseif license_key.status == 'Sold' %}
                                {% set statusClass = 'status-sold' %}
                            {% elseif license_key.status == 'Expired' %}
                                {% set statusClass = 'status-expired' %}
                            {% elseif license_key.status == 'Deactivated' %}
                                {% set statusClass = 'status-deactivated' %}
                            {% endif %}
                            <span class="status-badge {{ statusClass }}">{{ license_key.status }}</span>
                        </td>

                        <td data-search="{{ license_key.game ? license_key.game.title|lower : 'n/a' }}">
                            {% if license_key.game %}
                                <div class="game-info">
                                    <span class="game-title">{{ license_key.game.title }}</span>
                                    <small class="game-price">${{ license_key.game.price }}</small>
                                </div>
                            {% else %}
                                <span class="text-muted">N/A</span>
                            {% endif %}
                        </td>

                        <td data-search="{{ license_key.order ? license_key.order.orderNumber : 'n/a' }}">
                            {% if license_key.order %}
                                <div class="order-info">
                                    <span class="order-number">Order #{{ license_key.order.orderNumber }}</span>
                                    <small class="order-status status-{{ license_key.order.status|lower }}">{{ license_key.order.status }}</small>
                                </div>
                            {% else %}
                                <span class="text-muted">N/A</span>
                            {% endif %}
                        </td>

                        <!-- ✅ Created By Column -->
                        <td data-search="{{ license_key.createdBy ? license_key.createdBy.username|lower : 'unknown' }}">
                            {% if license_key.createdBy %}
                                <div class="creator-info">
                                    <div class="creator-name">
                                        {{ license_key.createdBy.username }}
                                    </div>
                                </div>
                            {% else %}
                                <span class="text-muted">Unknown</span>
                            {% endif %}
                        </td>

                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('app_license_key_show', {'id': license_key.id}) }}" 
                                   class="btn-action btn-view" 
                                   title="View Details">
                                    👁️
                                </a>
                                <a href="{{ path('app_license_key_edit', {'id': license_key.id}) }}" 
                                   class="btn-action btn-edit {% if not is_granted('EDIT', license_key) %}disabled{% endif %}" 
                                   title="Edit License Key"
                                   {% if not is_granted('EDIT', license_key) %}onclick="return false;" style="opacity: 0.5; cursor: not-allowed;"{% endif %}>
                                    ✏️
                                </a>
                                <form method="post" 
                                      action="{{ path('app_license_key_delete', {'id': license_key.id}) }}" 
                                      class="d-inline delete-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ license_key.id) }}">
                                    <button type="button" 
                                            class="btn-action btn-delete {% if not is_granted('DELETE', license_key) %}disabled{% endif %} delete-btn" 
                                            title="Delete License Key"
                                            data-key-id="{{ license_key.id }}"
                                            data-key-code="{{ license_key.code }}"
                                            data-game-title="{{ license_key.game ? license_key.game.title : 'Unknown Game' }}"
                                            {% if not is_granted('DELETE', license_key) %}disabled style="opacity: 0.5; cursor: not-allowed;"{% endif %}>
                                        🗑️
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="empty-state">
                            <div class="empty-content">
                                <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                                </svg>
                                <h3>No License Keys Found</h3>
                                <p>Start by adding your first license key</p>
                                <a href="{{ path('app_license_key_new') }}" class="btn-primary-small">Add License Key</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <!-- ✅ jQuery -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <!-- ✅ DataTables -->
  <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

  <script>
    $(document).ready(function () {
        // DataTable initialization
        if (!$.fn.DataTable.isDataTable('#myTable')) {
            $('#myTable').DataTable({
                pageLength: 10,
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search license keys, game, or creator..."
                },
                columnDefs: [
                    { targets: 0, type: 'num' },
                    { targets: 1, type: 'string' },
                    { targets: 2, type: 'string' },
                    { targets: 3, type: 'string' },
                    { targets: 4, type: 'string' },
                    { targets: 5, type: 'string' },
                    { targets: 6, orderable: false, searchable: false }
                ],
                order: [[0, 'desc']]
            });
            console.log("✅ DataTable initialized successfully for License Keys!");
        }

        // Minimalist confirmation modal logic
        const confirmationModal = $('#confirmationModal');
        const confirmationMessage = $('#confirmationMessage');
        const cancelBtn = $('#cancelBtn');
        const confirmBtn = $('#confirmBtn');
        
        let formToSubmit = null;

        // Handle delete button click
        $(document).on('click', '.delete-btn:not(.disabled)', function(e) {
            e.preventDefault();
            
            const keyId = $(this).data('key-id');
            const keyCode = $(this).data('key-code');
            const gameTitle = $(this).data('game-title');
            
            formToSubmit = $(this).closest('form');
            
            // Update message with specific license key info
            confirmationMessage.text(`Are you sure you want to delete license key "${keyCode}" for "${gameTitle}"? This action cannot be undone.`);
            
            // Show modal
            confirmationModal.addClass('active');
        });

        // Handle cancel button
        cancelBtn.on('click', function() {
            confirmationModal.removeClass('active');
            formToSubmit = null;
        });

        // Handle confirm button
        confirmBtn.on('click', function() {
            if (formToSubmit) {
                formToSubmit.submit();
            }
            confirmationModal.removeClass('active');
            formToSubmit = null;
        });

        // Close modal when clicking outside
        confirmationModal.on('click', function(e) {
            if (e.target === this) {
                confirmationModal.removeClass('active');
                formToSubmit = null;
            }
        });

        // Close modal with Escape key
        $(document).on('keydown', function(e) {
            if (e.key === 'Escape' && confirmationModal.hasClass('active')) {
                confirmationModal.removeClass('active');
                formToSubmit = null;
            }
        });
    });
  </script>
{% endblock %}