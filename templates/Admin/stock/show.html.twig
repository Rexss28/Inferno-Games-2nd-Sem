{% extends 'reusable/final_layout.html.twig' %}

{% block title %}Stock Details{% endblock %}

{% block body_class %}stock-Show-page{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('stock_show') }}
{% endblock %}

{% block content %}
    <div class="stock-show-container">
        <h1>Stock Details</h1>

        <div class="table-wrapper">
            <table class="table stock-details-table">
                <tbody>
                    <tr>
                        <th>ID</th>
                        <td>{{ stock.id }}</td>
                    </tr>
                    <tr>
                        <th>Available Quantity</th>
                        <td>{{ stock.availableQuantity }}</td>
                    </tr>
                    <tr>
                        <th>Total Quantity</th>
                        <td>{{ stock.totalQuantity }}</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>{{ stock.status }}</td>
                    </tr>
                    <tr>
                        <th>Game</th>
                        <td>{{ stock.game ? stock.game.title : 'N/A' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="action-buttons">
            <a href="{{ path('app_stock_index') }}" class="btn btn-secondary">Back to List</a>
            <a href="{{ path('app_stock_edit', {'id': stock.id}) }}" class="btn btn-primary">Edit</a>
            {{ include('Admin/stock/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
