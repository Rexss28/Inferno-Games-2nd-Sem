{# Optional: ig_nav — 'games' | 'store' | 'about' | 'support' for active state #}
<header class="ig-header">
    <a href="{{ path('app_landing_page') }}" class="ig-header__brand">
        <span class="ig-header__logo" aria-hidden="true">🔥</span>
        <span>Inferno Games</span>
    </a>

    <nav class="ig-nav" aria-label="Primary">
        {# <a class="ig-nav__link{% if ig_nav|default('') == 'games' %} ig-nav__link--active{% endif %}" href="{{ path('app_product_index') }}">Games <span class="ig-nav__chev" aria-hidden="true"></span></a>
        <a class="ig-nav__link{% if ig_nav|default('') == 'store' %} ig-nav__link--active{% endif %}" href="{{ path('app_product_index') }}">Store <span class="ig-nav__chev" aria-hidden="true"></span></a> #}
        <a class="ig-nav__link{% if ig_nav|default('') == 'about' %} ig-nav__link--active{% endif %}" href="{{ path('app_about_page') }}">About <span class="ig-nav__chev" aria-hidden="true"></span></a>
