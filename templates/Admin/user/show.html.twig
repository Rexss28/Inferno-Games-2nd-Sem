{% extends 'reusable/final_layout.html.twig' %}

{% block title %}{{ user.username }} - User Profile{% endblock %}

{% block body_class %}user-show-page{% endblock %}
{% block stylesheets %}
  {{ parent() }}
  {{ encore_entry_link_tags('user_show') }}
  <style>
    .status-info {
        margin-bottom: 2rem;
    }
    
    .status-display {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        margin-left: 0.5rem;
    }
    
    .status-active { background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
    .status-inactive { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
    .status-archived { background: rgba(107, 114, 128, 0.15); color: #6b7280; border: 1px solid rgba(107, 114, 128, 0.3); }
    
    .status-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }
    
    .status-action-btn {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 500;
        font-size: 0.85rem;
        cursor: pointer;
        border: 1px solid;
        transition: all 0.2s ease;
        background: transparent;
    }
    
    .btn-activate { color: #10b981; border-color: rgba(16, 185, 129, 0.3); }
    .btn-activate:hover { background: rgba(16, 185, 129, 0.1); }
    
    .btn-deactivate { color: #f59e0b; border-color: rgba(245, 158, 11, 0.3); }
    .btn-deactivate:hover { background: rgba(245, 158, 11, 0.1); }
    
    
    .btn-archive { color: #6b7280; border-color: rgba(107, 114, 128, 0.3); }
    .btn-archive:hover { background: rgba(107, 114, 128, 0.1); }
  </style>
{% endblock %}

{% block content %}
  <div class="user-show-container">
    <!-- Profile Header -->
    <div class="profile-header">
      <div class="user-avatar">
        <div class="avatar-circle">
          {{ user.username|first|upper }}
        </div>
      </div>
      <h1>{{ user.username }}</h1>
      <div class="status-info">
        <span>Status:</span>
        <span class="status-display status-{{ user.status }}">
          {{ user.status|upper }}
        </span>
        {# {% if user.statusReason %}
          <div style="color: #888; font-size: 0.9rem; margin-top: 0.5rem;">
            Reason: {{ user.statusReason }}
          </div>
        {% endif %} #}
        
        <!-- Status Action Buttons -->
        <div class="status-actions">
          {% if user.status != 'active' %}
            <form method="post" action="{{ path('app_user_status', {'id': user.id, 'status': 'activate'}) }}" style="display: inline;">
              <input type="hidden" name="_token" value="{{ csrf_token('status' ~ user.id) }}">
              <button type="submit" class="status-action-btn btn-activate">Activate</button>
            </form>
          {% endif %}
          
          {# {% if user.status != 'inactive' %}
            <form method="post" action="{{ path('app_user_status', {'id': user.id, 'status': 'deactivate'}) }}" style="display: inline;">
              <input type="hidden" name="_token" value="{{ csrf_token('status' ~ user.id) }}">
              <button type="submit" class="status-action-btn btn-deactivate">Deactivate</button>
            </form>
          {% endif %} #}
          
        
          
          {# {% if user.status != 'archived' %}
            <form method="post" action="{{ path('app_user_status', {'id': user.id, 'status': 'archive'}) }}" style="display: inline;">
              <input type="hidden" name="_token" value="{{ csrf_token('status' ~ user.id) }}">
              <button type="submit" class="status-action-btn btn-archive">Archive</button>
            </form>
          {% endif %} #}
          
          {# {% if user.status == 'archived' %}
            <form method="post" action="{{ path('app_user_restore', {'id': user.id}) }}" style="display: inline;">
              <input type="hidden" name="_token" value="{{ csrf_token('restore' ~ user.id) }}">
              <button type="submit" class="status-action-btn btn-activate">Restore</button>
            </form>
          {% endif %} #}
        </div>
      </div>
    </div>

    <!-- Profile Information -->
    <div class="profile-info">
      <!-- User ID -->
      <div class="info-item">
        <div class="info-label">User ID</div>
        <div class="info-value">#{{ user.id }}</div>
      </div>

      <!-- Username -->
      <div class="info-item">
        <div class="info-label">Username</div>
        <div class="info-value">{{ user.username }}</div>
      </div>

      <!-- Roles -->
      <div class="info-item">
        <div class="info-label">Roles</div>
        <div class="role-badges">
          {% if user.getDisplayRoles() is not empty %}
            {% for role in user.getDisplayRoles() %}
              {% set roleName = role|replace({'ROLE_': ''}) %}
              {% set roleClass = '' %}
              
              {% if 'ADMIN' in roleName|upper %}
                {% set roleClass = 'admin-role' %}
              {% elseif 'STAFF' in roleName|upper %}
                {% set roleClass = 'staff-role' %}
              {% else %}
                {% set roleClass = 'user-role' %}
              {% endif %}
              
              <span class="role-badge {{ roleClass }}">
                {{ roleName }}
              </span>
            {% endfor %}
          {% else %}
            <span class="role-badge user-role">USER</span>
          {% endif %}
        </div>
      </div>

      <!-- Timestamps -->
      {% if user.archivedAt %}
        <div class="info-item">
          <div class="info-label">Archived At</div>
          <div class="info-value">{{ user.archivedAt|date('Y-m-d H:i') }}</div>
        </div>
      {% endif %}
      

    </div>

    <!-- Action Buttons -->
    <div class="profile-actions">
      <a href="{{ path('app_user_index') }}" class="action-btn btn-secondary">
        ← Back to Users
      </a>
      
      <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="action-btn btn-primary">
        Edit Profile
      </a>
      
      <form method="post" 
            action="{{ path('app_user_delete', {'id': user.id}) }}" 
            onsubmit="return confirm('Are you sure you want to delete this user?');"
            class="delete-form">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
        <button class="action-btn btn-danger">
          Delete User
        </button>
      </form>
    </div>
  </div>
{% endblock %}